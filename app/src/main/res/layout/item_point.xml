<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:padding="2dp">
    <TextView android:id="@+id/tvXY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0,0" android:textColor="#FFF" android:textSize="10sp"/>
    <EditText android:id="@+id/etDelay" android:layout_width="40dp" android:layout_height="wrap_content" android:hint="延" android:textSize="10sp" android:inputType="number"/>
    <EditText android:id="@+id/etDur" android:layout_width="40dp" android:layout_height="wrap_content" android:hint="长" android:textSize="10sp" android:inputType="number"/>
    <EditText android:id="@+id/etCnt" android:layout_width="40dp" android:layout_height="wrap_content" android:hint="次" android:textSize="10sp" android:inputType="number"/>
    <EditText android:id="@+id/etRnd" android:layout_width="40dp" android:layout_height="wrap_content" android:hint="随" android:textSize="10sp" android:inputType="number"/>
    <Button android:id="@+id/btnDel" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:textSize="10sp"/>
</LinearLayout>
